# ---- Produktion (Docker Compose) -------------------------------------------
# Öffentlicher Domainname des Servers (DNS muss auf die Server-IP zeigen)
DOMAIN=lernwelt.example.de
PUBLIC_ORIGIN=https://lernwelt.example.de

# ---- Lokale Entwicklung (npm run dev) -------------------------------------
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=./data
# Nur für Safari auf http://localhost nötig – in Produktion verboten:
# COOKIE_SECURE=false

LOG_LEVEL=info
