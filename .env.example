# ---- Produktion (Docker Compose) -------------------------------------------
# Öffentlicher Domainname des Servers (DNS muss auf die Server-IP zeigen)
DOMAIN=lernwelt.example.de
PUBLIC_ORIGIN=https://lernwelt.example.de

# ---- Lokale Entwicklung (npm run dev) -------------------------------------
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=./data
# Nur für Safari auf http://localhost nötig – in Produktion verboten:
# COOKIE_SECURE=false

LOG_LEVEL=info

# ---- Datenschutz / Löschfristen (Tage) ----------------------------------------
# RETENTION_INACTIVE_DAYS=183     # Konten von Lernenden nach Inaktivität löschen
# RETENTION_WARN_DAYS=30          # Warnung im Dashboard vor der Löschung
# RETENTION_ATTEMPTS_DAYS=56      # Einzelversuche → anonyme Statistik
# RETENTION_ACTIVITY_DAYS=365     # Online-Minuten pro Tag
# RETENTION_AUDIT_DAYS=365        # Audit-Log
# SELF_DELETE_GRACE_DAYS=7        # Bedenkzeit bei Selbstlöschung

# ---- Angaben für die Datenschutzinformation --------------------------------------
# SCHOOL_NAME=Staatliche Berufsschule Musterstadt, Musterstraße 1, 12345 Musterstadt
# SCHOOL_CONTACT=Schulleitung, Tel. …
# DPO_CONTACT=Datenschutzbeauftragte/r der Schule, E-Mail …
# HOSTING_INFO=Oracle Cloud Infrastructure, Region Frankfurt (Auftragsverarbeitung nach Art. 28 DSGVO)

# ---- Sicherheit ----------------------------------------------------------------------
# REQUIRE_STAFF_2FA=true          # Zwei-Faktor-Anmeldung für Lehrkräfte verpflichtend
# APP_SECRET=                      # 64 Hex-Zeichen; sonst wird data/app-secret.key erzeugt

# ---- Backup (scripts/backup.sh) ------------------------------------------------------
# BACKUP_AGE_RECIPIENT=age1...     # öffentlicher age-Schlüssel
# BACKUP_KEEP_DAYS=30
